{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/ValueStream.json",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/FieldDecl.json"
      },
      "minItems": 1,
      "contains": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/IdentityField.json"
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/ClauseRef.json"
      },
      "minItems": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/RelationDecl.json"
      }
    },
    "scope": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/StageDecl.json"
      }
    },
    "owner": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/OwnershipDecl.json"
    },
    "lifecycle": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/LifecycleDecl.json"
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/ProvenanceDecl.json"
    }
  },
  "required": [
    "fields",
    "clauses"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A value stream: the end-to-end path from a triggering stakeholder to the\nvalue received. `clauses` is required because a value stream exists to make a\nguarantee; `operations` is forbidden by the seal.",
  "allOf": [
    {
      "properties": {
        "relations": {
          "items": {
            "properties": {
              "verb": {
                "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/ValueStreamVerb.json"
              }
            }
          }
        }
      }
    }
  ]
}

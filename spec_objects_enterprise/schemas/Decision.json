{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/Decision.json",
  "type": "object",
  "properties": {
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.0/ClauseRef.json"
      },
      "minItems": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.0/FieldDecl.json"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.0/RelationDecl.json"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/AlternativeDecl.json"
      }
    },
    "owner": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/OwnershipDecl.json"
    },
    "lifecycle": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/LifecycleDecl.json"
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/ProvenanceDecl.json"
    }
  },
  "required": [
    "clauses"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A decision: a commitment taken, stated as an asserted clause rather than as\nprose. `operations` is forbidden by the seal.",
  "allOf": [
    {
      "properties": {
        "relations": {
          "items": {
            "properties": {
              "verb": {
                "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/DecisionVerb.json"
              }
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/TargetDecl.json",
  "type": "object",
  "properties": {
    "measure": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.0/SemanticId.json"
    },
    "comparator": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-enterprise/0.2.0/Comparator.json"
    },
    "bound": {
      "type": "string"
    },
    "by": {
      "type": "string"
    },
    "doc": {
      "type": "string"
    }
  },
  "required": [
    "measure",
    "comparator",
    "bound"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A declared target against a named measure definition. `measure` is a\n`SemanticId` naming a `kpi` declaration, and `bound` is the limit the\nobjective commits to — never an observed reading."
}
